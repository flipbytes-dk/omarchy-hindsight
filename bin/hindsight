#!/usr/bin/env python3
"""Hindsight - an always-on, local, searchable memory of your screen.

Everything that can go wrong lives here rather than in QML: the capture loop,
the change detection that keeps the disk from filling, the OCR queue, the
blocklist that decides a frame must never exist, and the pruning. The shell
side only renders what this prints.

Nothing here ever opens a network socket. That is a design constraint, not an
implementation detail - see doctor().
"""

import difflib
import json
import math
import os
import queue
import re
import shutil
import signal
import sqlite3
import stat as statmod
import subprocess
import sys
import threading
import time

HOME = os.path.expanduser("~")
DATA = os.environ.get("HINDSIGHT_DATA") or os.path.join(
    os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share"),
    "omarchy-hindsight")
CONFIG = os.environ.get("HINDSIGHT_CONFIG") or os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"),
    "omarchy-hindsight", "config.json")

FRAMES = os.path.join(DATA, "frames")
DB_PATH = os.path.join(DATA, "index.db")
STATE_PATH = os.path.join(DATA, "state.json")
PAUSE_MARKER = os.path.join(DATA, "paused")

# A screen that differs from the last kept frame in fewer than this many of the
# 1024 hash bits is the same screen with a blinking cursor on it. Storing those
# is what turns a screen history into a disk-eating toy.
DEFAULTS = {
    "interval": 4.0,
    "budgetMB": 4096,
    "retentionDays": 0,
    "quality": 60,
    "changeBits": 12,
    "ocr": True,
    "ocrTimeout": 25,
    "blocklist": [
        "1password", "bitwarden", "keepassxc", "keepass", "gnome-keyring",
        "seahorse", "private browsing", "incognito", "inprivate",
        # A screensaver is idle time wearing a picture. Capturing it wastes
        # disk and, because its few words score highly, poisons search.
        "screensaver", "org.omarchy.screensaver",
    ],
    # Layer-shell surfaces are matched by namespace, and a notification
    # daemon names its surface after itself rather than after whatever raised
    # the notification. Blocking on "1password" can never catch a 1Password
    # toast, so the daemons are named directly: a frame is skipped while any
    # notification is on screen, because the code in it is not ours to judge.
    "blocklistLayers": [
        "mako", "swaync", "dunst", "fnott",
        # Both spellings: a bar writes "notifications", astal and eww
        # examples write "notification", and "notification-popups" and
        # "quickshell:notifications" are the same surface under a separator
        # the matcher has to know about.
        "notifications", "notification",
        "swaylock", "hyprlock", "lockscreen", "wlogout",
        # fuzzel and tofi both name their surface "launcher" rather than
        # themselves, which is why Hyprland blur rules are written against
        # that word and not against the binary.
        "rofi", "fuzzel", "wofi", "anyrun", "tofi", "launcher",
    ],
    "blocklistTitles": [],
}

# A record of everything that has been on screen is the most private thing on
# the machine. Nothing here may be readable by another local user, so every
# directory is 0700 and every file 0600 - enforced by umask for anything new
# and repaired on startup for anything an earlier version already wrote.
DIR_MODE = 0o700
FILE_MODE = 0o600

HASH_N = 32          # 32x32 grid -> 1024-bit average hash
HASH_BITS = HASH_N * HASH_N
MIN_RESULT_CHARS = 60  # below this a frame carries no context worth showing
# Capture keeps anything past a 12-bit change, which is right for an archive
# but wrong for a result list: three near-identical frames are one moment, and
# showing them three times spends the list on nothing.
RESULT_SAME_MOMENT_BITS = 60
OCR_QUEUE_MAX = 8    # bounded: OCR is ~1.5s, capture is ~40ms; drop, never lag


# --------------------------------------------------------------------------
# config + paths


def config_stamp():
    """Something cheap that changes when the config does."""
    try:
        info = os.stat(CONFIG)
        return (info.st_mtime_ns, info.st_size, info.st_ino)
    except OSError:
        return None


def load_config():
    cfg = dict(DEFAULTS)
    try:
        raw = read_private(CONFIG)
        if raw is not None:
            user = json.loads(raw)
            if isinstance(user, dict):
                for key, value in user.items():
                    if key in cfg and value is not None:
                        cfg[key] = value
    except Unreadable as exc:
        # Loud, because the alternative is a user whose blocklist quietly
        # never applied.
        log("cannot read your config (%s); running on defaults, and your "
            "blocklist is NOT in effect" % exc)
    except Exception as exc:
        log("config unreadable (%s), using defaults" % exc)
    # These coercions used to sit outside the try above, so "interval": "fast"
    # raised on every invocation and Service.qml respawned the recorder every
    # two seconds forever. A bad value falls back to the default and says so.
    for key, floor, cast in (("interval", 1.0, float),
                             ("changeBits", 0, int),
                             ("budgetMB", 64, int),
                             ("quality", 1, int),
                             ("ocrTimeout", 1, int)):
        try:
            value = cast(cfg[key])
            # float() accepts Infinity where int() raises, and json.loads
            # accepts the bare literal, so one token in the config could set
            # interval to inf and stop the recorder after a single tick.
            if not math.isfinite(value):
                raise ValueError("not a finite number")
            cfg[key] = max(floor, value)
        except (TypeError, ValueError, OverflowError):
            log("config value for %s (%r) is not usable; using %r"
                % (key, cfg[key], DEFAULTS[key]))
            cfg[key] = DEFAULTS[key]
    cfg["quality"] = min(100, cfg["quality"])
    return cfg


def log(message):
    sys.stderr.write("hindsight: %s\n" % message)
    sys.stderr.flush()


MAX_ARCHIVE_DEPTH = 8         # frames live two levels down; this is slack, not a limit to use
MAX_FRAME_BYTES = 64 * 1024 * 1024


SAFE_COMPONENT = re.compile(r"^[A-Za-z0-9._-]+$")


def open_archive():
    """Open the frames directory without resolving either it or its parent
    by name.

    Anchoring at os.open(FRAMES) still resolved the archive root as a
    pathname, so replacing the data directory with a symlink redirected
    every write, read and delete below it. DATA is opened with O_NOFOLLOW
    and "frames" is opened relative to that descriptor."""
    data_fd = None
    try:
        data_fd = os.open(DATA, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        info = os.fstat(data_fd)
        if info.st_uid != os.getuid() or not statmod.S_ISDIR(info.st_mode):
            log("refusing to use %s: not a directory of ours" % DATA)
            return None
        fd = os.open("frames", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                     dir_fd=data_fd)
        info = os.fstat(fd)
        if info.st_uid != os.getuid() or not statmod.S_ISDIR(info.st_mode):
            os.close(fd)
            log("refusing to use the frames directory: not ours")
            return None
        return fd
    except OSError:
        return None
    finally:
        if data_fd is not None:
            try:
                os.close(data_fd)
            except OSError:
                pass


def archive_descend(path):
    """Open the directory holding `path`, descending from the archive one
    component at a time with O_NOFOLLOW.

    O_NOFOLLOW only guards the component it opens, so checking the final
    name is not enough: a symlinked day directory would send a write, a read
    or a delete anywhere on the disk. Walking from a descriptor of the
    archive itself means every component is checked, and the directory
    cannot be swapped for a link between the check and the use.

    Returns (fds, name) where fds[-1] is the parent directory, or (None,
    reason)."""
    try:
        rel = os.path.relpath(path, FRAMES)
    except ValueError:
        return None, "outside the archive"
    parts = rel.split(os.sep)
    if os.path.isabs(rel) or len(parts) > MAX_ARCHIVE_DEPTH:
        return None, "outside the archive"
    # Frames are named by this program and never contain anything but letters,
    # digits, dot, dash and underscore. Insisting on that rejects traversal,
    # percent escapes that Qt would later decode, and embedded NUL bytes,
    # which raise ValueError rather than OSError and escaped every guard.
    # The character class alone is not enough: ".." is made entirely of
    # characters it allows, so traversal has to be rejected by name too.
    if any(part in (".", "..") for part in parts):
        return None, "outside the archive"
    if not all(SAFE_COMPONENT.match(part) for part in parts):
        return None, "not a name this program writes"

    root = open_archive()
    if root is None:
        return None, "archive unavailable"
    fds = [root]
    for part in parts[:-1]:
        try:
            fds.append(os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                               dir_fd=fds[-1]))
        except (OSError, ValueError) as exc:
            close_fds(fds)
            return None, str(exc)
    return fds, parts[-1]


def close_fds(fds):
    for fd in reversed(fds or []):
        try:
            os.close(fd)
        except OSError:
            pass


def open_day_dir(day):
    """Create and open a day directory inside the archive, refusing a link.

    If something has replaced today's directory with a symlink, opening it
    with O_NOFOLLOW fails and no frame is written, which is the right
    outcome: a missing frame beats a frame written somewhere else."""
    if day in (".", "..") or not SAFE_COMPONENT.match(day):
        log("refusing to use %r as a day directory" % day)
        return None
    root = open_archive()
    if root is None:
        # The archive can disappear under a running recorder: somebody
        # follows the README's removal step without disabling the plugin
        # first. Recreate it rather than wedging capture until next login.
        ensure_dirs()
        root = open_archive()
    if root is None:
        log("cannot open the archive")
        return None
    fd = None
    try:
        try:
            os.mkdir(day, DIR_MODE, dir_fd=root)
        except FileExistsError:
            pass
        fd = os.open(day, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                     dir_fd=root)
        info = os.fstat(fd)
        if info.st_uid != os.getuid() or not statmod.S_ISDIR(info.st_mode):
            log("refusing to use %s: not a directory of ours" % day)
            os.close(fd)
            return None
        if (info.st_mode & 0o777) != DIR_MODE:
            os.fchmod(fd, DIR_MODE)
        return fd
    except OSError as exc:
        log("cannot open the day directory %s (%s)" % (day, exc))
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
        return None
    finally:
        try:
            os.close(root)
        except OSError:
            pass


def read_frame_bytes(path, limit=MAX_FRAME_BYTES):
    """Read a stored frame, refusing anything that is not a regular file of
    ours inside the archive."""
    fds, name = archive_descend(path)
    if fds is None:
        log("refusing to read %s: %s" % (path, name))
        return None
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                     dir_fd=fds[-1])
    except OSError as exc:
        log("could not read %s (%s)" % (path, exc))
        close_fds(fds)
        return None
    try:
        info = os.fstat(fd)
        if not statmod.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
            log("refusing to read %s: not a regular file of ours" % path)
            return None
        if info.st_size > limit:
            log("refusing to read %s: larger than %d bytes" % (path, limit))
            return None
        chunks = []
        while True:
            chunk = os.read(fd, 1 << 20)
            if not chunk:
                break
            chunks.append(chunk)
        return b"".join(chunks)
    except OSError:
        return None
    finally:
        try:
            os.close(fd)
        except OSError:
            pass
        close_fds(fds)


MAX_TEXT_BYTES = 256 * 1024   # config and state are small; anything larger is not ours


class Unreadable(Exception):
    """The file is there but this refused to read it. Not the same as absent:
    treating the two alike let a symlinked config silently fall back to
    defaults, and the next write replaced the user's real file."""


def read_private(path, limit=MAX_TEXT_BYTES):
    """Read a small file of ours, refusing links, odd types and runaway size.

    Returns None when the file is missing or fails any of those checks, so
    every caller falls back to defaults rather than to whatever was there."""
    fd = None
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        info = os.fstat(fd)
        if not statmod.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
            raise Unreadable("%s is not a regular file of ours" % path)
        if info.st_size > limit:
            raise Unreadable("%s is larger than %d bytes" % (path, limit))
        chunks = []
        total = 0
        while total <= limit:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        if total > limit:
            raise Unreadable("%s is larger than %d bytes" % (path, limit))
        return b"".join(chunks).decode("utf-8", "replace")
    except FileNotFoundError:
        return None
    except OSError as exc:
        raise Unreadable("%s could not be read (%s)" % (path, exc))
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass


def write_private(path, data, dir_fd=None, name=None):
    """Create or replace a file of ours, never through a symlink."""
    if isinstance(data, str):
        data = data.encode("utf-8")
    fd = None
    try:
        flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW
        if dir_fd is not None:
            fd = os.open(name, flags, FILE_MODE, dir_fd=dir_fd)
        else:
            fd = os.open(path, flags, FILE_MODE)
        os.fchmod(fd, FILE_MODE)
        os.write(fd, data)
        return True
    except OSError as exc:
        log("could not write %s (%s)" % (path, exc))
        return False
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass


def secure(path, mode, dir_fd=None, name=None):
    """Set a private mode through a descriptor rather than a pathname.

    os.chmod follows symlinks, so a link planted in the archive would have
    made the startup repair change the mode of something else entirely.
    Opening with O_NOFOLLOW refuses the link, and fchmod then acts on the
    object actually opened rather than on whatever the name meant a moment
    ago. Anything owned by another user, or of the wrong type, is left
    alone."""
    want_dir = (mode == DIR_MODE)
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
    if want_dir:
        flags |= os.O_DIRECTORY
    fd = None
    try:
        if dir_fd is not None:
            fd = os.open(name, flags, dir_fd=dir_fd)
        else:
            fd = os.open(path, flags)
        info = os.fstat(fd)
        if info.st_uid != os.getuid():
            return False
        if want_dir and not statmod.S_ISDIR(info.st_mode):
            return False
        if not want_dir and not statmod.S_ISREG(info.st_mode):
            return False
        if (info.st_mode & 0o777) != mode:
            os.fchmod(fd, mode)
            return True
    except PermissionError:
        # A file whose owner cannot read it still has to be repaired: those
        # are precisely the ones violating the rule. O_PATH opens without
        # read permission, and the mode is changed through the descriptor.
        return secure_by_path(path, mode, dir_fd, name)
    except OSError:
        pass
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
    return False


def secure_by_path(path, mode, dir_fd=None, name=None):
    """chmod through /proc/self/fd of an O_PATH descriptor.

    O_PATH refuses to follow a final symlink with O_NOFOLLOW and needs no
    read permission, so this reaches files plain open() cannot."""
    fd = None
    try:
        flags = os.O_PATH | os.O_NOFOLLOW
        if dir_fd is not None:
            fd = os.open(name, flags, dir_fd=dir_fd)
        else:
            fd = os.open(path, flags)
        info = os.stat(fd)
        if info.st_uid != os.getuid():
            return False
        if not (statmod.S_ISREG(info.st_mode) or statmod.S_ISDIR(info.st_mode)):
            return False
        if (info.st_mode & 0o777) == mode:
            return False
        os.chmod("/proc/self/fd/%d" % fd, mode)
        return True
    except OSError as exc:
        log("could not repair permissions on %s (%s)" % (name or path, exc))
        return False
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass


def harden_dir(fd, path, depth=0):
    """Repair one directory's contents, descending through descriptors only."""
    fixed = 0
    if depth > MAX_ARCHIVE_DEPTH:
        log("stopping the permission repair below %s: nested too deep" % path)
        return 0
    try:
        entries = list(os.scandir(fd))
    except OSError:
        return 0
    for entry in entries:
        try:
            if entry.is_symlink():
                # Never repair a link. Pointing at somebody else's file is
                # the whole trick, and the link itself carries no mode worth
                # keeping.
                continue
            if entry.is_dir(follow_symlinks=False):
                if secure(None, DIR_MODE, dir_fd=fd, name=entry.name):
                    fixed += 1
                child = None
                try:
                    child = os.open(entry.name,
                                    os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                                    dir_fd=fd)
                    fixed += harden_dir(child, os.path.join(path, entry.name), depth + 1)
                except OSError:
                    pass
                finally:
                    if child is not None:
                        try:
                            os.close(child)
                        except OSError:
                            pass
            elif entry.is_file(follow_symlinks=False):
                if secure(None, FILE_MODE, dir_fd=fd, name=entry.name):
                    fixed += 1
        except OSError:
            continue
    return fixed


def harden_tree(root):
    """Repair permissions written by an earlier, more careless version."""
    fixed = 1 if secure(root, DIR_MODE) else 0
    fd = None
    try:
        fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        fixed += harden_dir(fd, root)
    except OSError as exc:
        # Saying nothing here is how a symlinked archive root produced a
        # confident "0 paths repaired" while nothing was repaired at all.
        log("cannot repair permissions under %s (%s)" % (root, exc))
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
    return fixed


def harden_all():
    fixed = harden_tree(DATA) + harden_tree(os.path.dirname(CONFIG))
    if fixed:
        log("tightened permissions on %d existing path(s)" % fixed)
    return fixed


def ensure_dirs():
    os.makedirs(FRAMES, mode=DIR_MODE, exist_ok=True)
    os.makedirs(os.path.dirname(CONFIG), mode=DIR_MODE, exist_ok=True)
    # makedirs only applies the mode to the leaf it creates, so the parents
    # and any directory that already existed are set explicitly.
    for path in (DATA, FRAMES, os.path.dirname(CONFIG)):
        secure(path, DIR_MODE)


# --------------------------------------------------------------------------
# database


def secure_db_files():
    for suffix in ("", "-wal", "-shm"):
        secure(DB_PATH + suffix, FILE_MODE)


def check_db_path():
    """sqlite3.connect follows symlinks, so a planted link would send the
    whole index somewhere else. The same goes for the WAL and shared-memory
    files SQLite creates beside it."""
    for suffix in ("", "-wal", "-shm"):
        target = DB_PATH + suffix
        try:
            info = os.lstat(target)
        except FileNotFoundError:
            continue
        except OSError as exc:
            raise RuntimeError("cannot inspect %s (%s)" % (target, exc))
        if statmod.S_ISLNK(info.st_mode):
            raise RuntimeError("%s is a symlink; refusing to open it" % target)
        if not statmod.S_ISREG(info.st_mode):
            raise RuntimeError("%s is not a regular file" % target)
        if info.st_uid != os.getuid():
            raise RuntimeError("%s is owned by another user" % target)


def connect():
    ensure_dirs()
    check_db_path()
    conn = sqlite3.connect(DB_PATH, timeout=15)
    conn.execute("PRAGMA journal_mode=WAL")
    # After the pragma, not before: the -wal and -shm files do not exist
    # until it runs, so securing them first was a no-op on a fresh database
    # and the README's claim about the WAL rested entirely on the umask.
    secure_db_files()
    conn.execute("PRAGMA synchronous=NORMAL")
    conn.execute("""
        CREATE TABLE IF NOT EXISTS frames(
            id INTEGER PRIMARY KEY,
            ts REAL NOT NULL,
            day TEXT NOT NULL,
            path TEXT NOT NULL,
            app TEXT,
            title TEXT,
            monitor TEXT,
            hash TEXT,
            bytes INTEGER DEFAULT 0,
            ocr INTEGER DEFAULT 0
        )""")
    conn.execute("CREATE INDEX IF NOT EXISTS frames_ts ON frames(ts)")
    conn.execute("CREATE INDEX IF NOT EXISTS frames_day ON frames(day)")
    conn.execute("CREATE INDEX IF NOT EXISTS frames_ocr ON frames(ocr)")
    # The FTS table keeps its own copy of the text. That is deliberate: a
    # contentless table can match a query but cannot produce snippet(), and a
    # search result with no visible words is not a search result. The text is
    # a rounding error next to the images.
    migrate_fts(conn)
    conn.execute("""
        CREATE VIRTUAL TABLE IF NOT EXISTS frames_fts
        USING fts5(text, app, title)""")
    conn.commit()
    return conn


def migrate_fts(conn):
    """Rebuild a contentless frames_fts from an earlier version in place.

    Frames keep their images, so the text is recoverable: everything is marked
    un-read and the backfill worker re-reads it from the stored frame.
    """
    row = conn.execute(
        "SELECT sql FROM sqlite_master WHERE type='table' AND name='frames_fts'"
    ).fetchone()
    if not row or not row[0] or "content=''" not in row[0].replace(" ", ""):
        return
    log("rebuilding search index (was contentless); frames will be re-read")
    conn.execute("DROP TABLE frames_fts")
    conn.execute("UPDATE frames SET ocr=0")
    conn.commit()


def fts_supported():
    try:
        probe = sqlite3.connect(":memory:")
        probe.execute("CREATE VIRTUAL TABLE t USING fts5(a)")
        probe.close()
        return True
    except Exception:
        return False


# --------------------------------------------------------------------------
# perceptual hash, in pure Python straight off the PPM
#
# This is the hot path: it runs on every tick whether or not anything is kept,
# so it must not spawn a process. Measured at 0.4ms for 1280x800.


def parse_ppm(buf):
    """Return (width, height, offset) for a binary P6 PPM, or None."""
    if not buf.startswith(b"P6"):
        return None
    i = 2
    fields = []
    while len(fields) < 3:
        while i < len(buf) and buf[i:i + 1].isspace():
            i += 1
        if buf[i:i + 1] == b"#":
            while i < len(buf) and buf[i:i + 1] != b"\n":
                i += 1
            continue
        j = i
        while j < len(buf) and not buf[j:j + 1].isspace():
            j += 1
        if j >= len(buf):
            return None
        try:
            fields.append(int(buf[i:j]))
        except ValueError:
            return None
        i = j
    return fields[0], fields[1], i + 1


def average_hash(buf):
    parsed = parse_ppm(buf)
    if not parsed:
        return None
    width, height, offset = parsed
    if width <= 0 or height <= 0:
        return None
    samples = []
    append = samples.append
    for gy in range(HASH_N):
        row = offset + ((gy * height) // HASH_N) * width * 3
        for gx in range(HASH_N):
            o = row + ((gx * width) // HASH_N) * 3
            if o + 2 >= len(buf):
                return None
            append((buf[o] * 299 + buf[o + 1] * 587 + buf[o + 2] * 114) // 1000)
    mean = sum(samples) // len(samples)
    bits = 0
    for index, value in enumerate(samples):
        if value > mean:
            bits |= 1 << index
    return bits


def distance(a, b):
    if a is None or b is None:
        return HASH_BITS
    return bin(a ^ b).count("1")


# --------------------------------------------------------------------------
# desktop probes


def run(cmd, timeout=5, stdin_bytes=None):
    try:
        proc = subprocess.run(
            cmd, capture_output=True, timeout=timeout, input=stdin_bytes)
        return proc.returncode, proc.stdout, proc.stderr
    except FileNotFoundError:
        return 127, b"", b"missing"
    except subprocess.TimeoutExpired:
        return 124, b"", b"timeout"
    except Exception as exc:
        return 1, b"", str(exc).encode()


def active_window():
    """(probed, app, title).

    `probed` False means the compositor did not answer, or answered with
    something this cannot read. The blocklist is only as trustworthy as this
    probe, so a caller that cannot identify the focused window must not
    capture: a timed-out hyprctl while a password manager is focused would
    otherwise match no rule and archive the frame."""
    code, out, _ = run(["hyprctl", "activewindow", "-j"], timeout=3)
    if code != 0:
        return False, "", ""
    raw = out.decode("utf-8", "replace").strip()
    if not raw:
        return False, "", ""
    try:
        data = json.loads(raw)
    except Exception:
        return False, "", ""
    if not isinstance(data, dict) or "class" not in data:
        # hyprctl answers {} whenever the focused surface is not a toplevel:
        # a launcher, a polkit prompt, an OSD, a lock surface, the
        # screensaver. Those are exactly the moments the blocklist exists
        # for, so an unidentifiable surface is not permission to capture.
        return False, "", ""
    return True, str(data.get("class") or ""), str(data.get("title") or "")


def focused_monitor():
    """(probed, name, awake). An unanswered probe reports not-awake, so an
    indeterminate display state stops the capture rather than allowing it."""
    code, out, _ = run(["hyprctl", "monitors", "-j"], timeout=3)
    if code != 0:
        return False, None, False
    try:
        monitors = json.loads(out.decode("utf-8", "replace") or "[]")
    except Exception:
        return False, None, False
    if not isinstance(monitors, list) or not monitors:
        return False, None, False
    chosen = None
    for mon in monitors:
        if isinstance(mon, dict) and mon.get("focused"):
            chosen = mon
            break
    if chosen is None:
        chosen = monitors[0]
    # dpmsStatus False means the panel is asleep; grim would hand back a stale
    # or black frame and we would archive darkness.
    awake = chosen.get("dpmsStatus", True) is not False
    return True, str(chosen.get("name") or "") or None, awake


def visible_windows(monitor_name):
    """(probed, [(app, title), ...]) for everything shown on one output.

    grim captures a whole output, so checking only the focused window was
    never enough: on a tiling compositor a password manager tiled beside the
    terminal lands in the frame in full. Every window sharing the visible
    workspaces of this output has to clear the blocklist."""
    code, out, _ = run(["hyprctl", "monitors", "-j"], timeout=3)
    if code != 0:
        return False, []
    try:
        monitors = json.loads(out.decode("utf-8", "replace") or "[]")
    except Exception:
        return False, []
    if not isinstance(monitors, list):
        return False, []

    visible = set()
    found = False
    for mon in monitors:
        if not isinstance(mon, dict):
            return False, []
        if monitor_name and str(mon.get("name") or "") != monitor_name:
            continue
        found = True
        for key in ("activeWorkspace", "specialWorkspace"):
            space = mon.get(key)
            if isinstance(space, dict) and space.get("id") is not None:
                visible.add(space.get("id"))
    if not found or not visible:
        # No monitor by that name, or one that told us nothing about its
        # workspaces: better to stop than to guess what is on screen.
        return False, []

    code, out, _ = run(["hyprctl", "clients", "-j"], timeout=3)
    if code != 0:
        return False, []
    try:
        clients = json.loads(out.decode("utf-8", "replace") or "[]")
    except Exception:
        return False, []
    if not isinstance(clients, list):
        return False, []

    shown = []
    for client in clients:
        if not isinstance(client, dict):
            return False, []
        space = client.get("workspace")
        if not isinstance(space, dict) or space.get("id") is None:
            # A window whose workspace cannot be read is a window whose
            # visibility cannot be read. Do not quietly drop it.
            return False, []
        if space.get("id") not in visible:
            continue
        if client.get("mapped") is False or client.get("hidden") is True:
            continue
        shown.append((str(client.get("class") or ""),
                      str(client.get("title") or "")))
    return True, shown


NEVER_LOCKED_CLASSES = frozenset((
    "manager", "manager-early", "background", "background-light"))


def login_sessions():
    """Session ids worth asking about the lock state.

    The systemd user manager owns a session too, with class "manager", and it
    reports LockedHint=no forever. Asking it first and believing the first
    answer meant a locked graphical session read as unlocked."""
    ids = []
    from_env = os.environ.get("XDG_SESSION_ID")
    if from_env:
        ids.append(from_env)
    ids.append("self")
    code, out, _ = run(["loginctl", "list-sessions", "--no-legend"], timeout=3)
    if code == 0:
        mine = str(os.getuid())
        for line in out.decode("utf-8", "replace").splitlines():
            fields = line.split()
            if len(fields) < 2 or fields[1] != mine:
                continue
            # CLASS column, on systemd versions that print one. Drop only
            # the classes that can never hold a lock; "greeter",
            # "user-early" and "user-incomplete" are real sessions and an
            # exact match on "user" discarded them.
            if len(fields) >= 6 and fields[5] in NEVER_LOCKED_CLASSES:
                continue
            if fields[0] not in ids:
                ids.append(fields[0])
    return ids


def visible_layers(monitor_name):
    """(probed, [namespace, ...]) for layer surfaces drawn on one output.

    Notifications, launchers and overlays are not toplevel windows, so
    `hyprctl clients` cannot see them, but grim composites them into the
    frame. A notification showing a one-time code is exactly the thing the
    blocklist is for."""
    code, out, _ = run(["hyprctl", "layers", "-j"], timeout=3)
    if code != 0:
        return False, []
    body = out.decode("utf-8", "replace").strip()
    if not body:
        return False, []
    try:
        data = json.loads(body)
    except Exception:
        return False, []
    if not isinstance(data, dict):
        return False, []
    names = []
    found = not monitor_name
    for output, body in data.items():
        if monitor_name and output != monitor_name:
            continue
        found = True
        if not isinstance(body, dict):
            return False, []
        levels = body.get("levels")
        if not isinstance(levels, dict):
            return False, []
        for surfaces in levels.values():
            if not isinstance(surfaces, list):
                return False, []
            for surface in surfaces:
                if not isinstance(surface, dict):
                    return False, []
                namespace = surface.get("namespace")
                if namespace is None:
                    # A surface we cannot name is a surface we cannot clear.
                    return False, []
                # A daemon may keep a surface mapped at zero size or fully
                # transparent between notifications. Blocking on those stops
                # the recorder for as long as the daemon runs, rather than
                # for as long as something is on screen.
                if surface.get("w") == 0 or surface.get("h") == 0:
                    continue
                if surface.get("alpha") == 0:
                    continue
                names.append(str(namespace))
    if not found:
        # The same shape visible_windows() fails closed on. An output that is
        # not in the layers map is an output we know nothing about.
        return False, []
    return True, names


def compositor_locked():
    """True, False, or None, asked of the compositor rather than of logind.

    The lock this plugin actually ships against leaves no trace in either of
    the places the other probes look. Omarchy locks with an
    ext-session-lock-v1 surface drawn by the quickshell process that is
    already running, so there is no locker to find by name, and nothing sets
    logind's LockedHint: Hyprland 0.56 contains no reference to it, and
    neither does anything under /usr/share/omarchy. The session answers an
    unprompted "LockedHint=no" the whole time the screen is locked.

    The lock is visible in one place - it is one of the reasons a monitor
    cannot go solitary - which is what omarchy-hyprland-session-locked reads
    too. Hyprland stops at the first reason it finds, so a monitor still
    waiting for a workspace was never asked about the lock at all: that is
    None, not unlocked.
    """
    code, out, _ = run(["hyprctl", "monitors", "-j"], timeout=3)
    if code != 0:
        return None
    try:
        monitors = json.loads(out.decode("utf-8", "replace") or "[]")
    except Exception:
        return None
    if not isinstance(monitors, list) or not monitors:
        return None
    asked = False
    for mon in monitors:
        if not isinstance(mon, dict):
            return None
        blockers = mon.get("solitaryBlockedBy")
        if not isinstance(blockers, list):
            # A Hyprland too old to report the field cannot be asked, and a
            # question that cannot be asked is not an answer of "no".
            return None
        names = [str(item) for item in blockers]
        if "LOCK" in names:
            return True
        if "WORKSPACE" not in names:
            asked = True
    return False if asked else None


def session_locked():
    """True, False, or None when nothing could answer.

    None is not the same as unlocked. An unanswered question about whether
    the screen is locked is not permission to record it."""
    # The compositor is asked first because it is the only one of the three
    # that can see a session lock, and because it is a single call: the
    # pgrep-and-loginctl pair below measured 109 ms, which was most of the
    # gap between the last gate and the shutter. A smaller gap is worth more
    # than a second look across a large one.
    compositor = compositor_locked()
    if compositor is not None:
        return compositor

    # Everything below can only add a "locked". Reached when the compositor
    # could not be asked, where the old, weaker answer is better than none.
    #
    # run() rather than subprocess.run(): a missing pgrep used to raise here
    # and take the recorder down with it.
    for locker in ("hyprlock", "swaylock", "gtklock", "waylock"):
        code, _, _ = run(["pgrep", "-x", locker], timeout=3)
        if code == 0:
            return True
    # "self" fails outright when the process is not inside a session scope,
    # which is the normal case for something started by the shell. Measured:
    # `loginctl show-session self` exits 1 with "Caller does not belong to any
    # known session", so asking only that way made the lock state permanently
    # unknown and, with the fail-closed rule, stopped capture for good.
    for session in login_sessions():
        code, out, _ = run(["loginctl", "show-session", session,
                            "-p", "LockedHint", "--value"], timeout=3)
        if code != 0:
            continue
        if out.decode("utf-8", "replace").strip().lower() == "yes":
            # One session saying it is locked settles it. Returning on the
            # first answer instead let a session that can never lock speak
            # for one that had.
            return True
    # A handful of named lockers being absent is not knowing the screen is
    # clear, and neither is a LockedHint that nothing on this desktop writes.
    return None


def blocked_layer(cfg, namespaces):
    """Return the matching layer rule, or ''.

    Matched against blocklistLayers rather than blocklist, because the two
    name different things: one is an application, the other is whichever
    daemon drew the surface."""
    rules = cfg.get("blocklistLayers")
    if rules is None:
        rules = DEFAULTS["blocklistLayers"]
    for namespace in namespaces or []:
        hay = str(namespace or "").lower()
        for needle in rules:
            token = str(needle).lower().strip()
            if not token:
                continue
            # Anchored, not "contains": swaync's own surfaces are named
            # swaync-control-center and should match, but a status bar called
            # eww-notifications-bar is not a notification daemon and blocking
            # it would stop the recorder for good.
            # Namespaces name themselves at one end or the other:
            # "swaync-control-center" leads with the daemon, while a
            # reverse-DNS name like "org.freedesktop.Notifications" ends with
            # it. Matching either end catches both, and leaves the middle
            # alone, so "eww-notifications-bar" still records.
            #
            # A bar named "notifications-bar" does not, and there is no way
            # to tell it apart from a notification daemon by name. It blocks,
            # the panel names the rule that did it, and the rule can be taken
            # out of blocklistLayers. Erring the other way would mean
            # recording notification popups on every desktop that names the
            # surface for what it holds.
            parts = re.split(r"[-._:/]", hay)
            if hay == token or parts[0] == token or parts[-1] == token:
                return str(needle)
    return ""


def blocked_by(cfg, app, title):
    """Return the matching rule, or '' - the frame is never taken if set."""
    hay_app = (app or "").lower()
    hay_title = (title or "").lower()
    for needle in cfg.get("blocklist") or []:
        token = str(needle).lower().strip()
        if token and (token in hay_app or token in hay_title):
            return str(needle)
    for pattern in cfg.get("blocklistTitles") or []:
        try:
            if re.search(str(pattern), title or "", re.I):
                return str(pattern)
        except re.error as exc:
            # A rule the user wrote to protect something, silently discarded,
            # is worse than no rule: they believe they are covered. Treat it
            # as matching and complain, rather than capturing anyway.
            log("blocklistTitles pattern %r is not a valid regular "
                "expression (%s); blocking capture until it is fixed"
                % (pattern, exc))
            return str(pattern)
    return ""


def capture_gate(cfg, monitor):
    """Every reason not to photograph `monitor` right now, asked in one place.

    Returns (reason, rule, app, title). An empty reason means the shot may
    be taken; otherwise reason names the gate that refused, and rule names
    the blocklist entry that matched, if one did. app and title come back
    because the caller stores them with the frame, and a gate that answers
    the question without handing back the answer invites the caller to go
    and ask it a second time.

    tick() and doctor used to ask these questions separately and drifted
    apart: doctor grew the overlay check a round late, and still read a
    probe that could not answer as a probe that said yes, so running it
    with a broken hyprctl took exactly the frame the plugin promises never
    to take. One gate list now, and one set of failure semantics, because a
    gate added to one copy is a gate missing from the other.

    Every branch fails closed. A probe that cannot answer refuses the frame
    for the same reason a probe that answers "locked" does: neither of them
    said yes.
    """
    probed, app, title = active_window()
    if not probed:
        return "focused window unknown", "", "", ""
    rule = blocked_by(cfg, app, title)
    if rule:
        return "blocked", rule, app, title

    # grim hands back the whole output, so every window on it is in the
    # picture, not only the focused one.
    probed, windows = visible_windows(monitor)
    if not probed:
        return "window list unknown", "", app, title
    for other_app, other_title in windows:
        rule = blocked_by(cfg, other_app, other_title)
        if rule:
            return "blocked", rule, app, title

    # Notifications, lock screens and launchers are layer-shell surfaces.
    # They are on the output and in the picture, and never in the window
    # list.
    probed, layers = visible_layers(monitor)
    if not probed:
        return "overlay list unknown", "", app, title
    rule = blocked_layer(cfg, layers)
    if rule:
        return "blocked", rule, app, title

    # Last, because it is the slowest probe and the most consequential, so
    # its answer is the freshest thing in the frame.
    locked = session_locked()
    if locked is None:
        return "lock state unknown", "", app, title
    if locked:
        return "locked", "", app, title
    return "", "", app, title


def capture(monitor):
    cmd = ["grim", "-t", "ppm"]
    if monitor:
        cmd += ["-o", monitor]
    cmd.append("-")
    code, out, err = run(cmd, timeout=10)
    if code != 0 or not out:
        return None, err.decode("utf-8", "replace").strip()
    return out, ""


def encode_webp(ppm, quality):
    code, out, err = run(
        ["magick", "ppm:-", "-quality", str(quality), "webp:-"],
        timeout=20, stdin_bytes=ppm)
    if code != 0 or not out:
        return None, err.decode("utf-8", "replace").strip()
    return out, ""


# 0 not read yet, 1 read, 2 read but unreadable image, 3 no OCR tool -
# 3 is retried, because installing tesseract should heal the archive.
OCR_PENDING, OCR_DONE, OCR_DONE_UNREADABLE, OCR_TOOL_MISSING = 0, 1, 2, 3


def ocr_frame_file(path, timeout):
    """Recover text from a frame already on disk.

    The bytes are read here and piped in, rather than handing the path to
    magick. The path comes from the database, and ImageMagick reads meaning
    into a filename: prefixes and delegate formats can make it open things,
    or run things, that were never intended. It is never shown the name."""
    data = read_frame_bytes(path)
    if not data:
        return None
    code, ppm, _ = run(["magick", "webp:-", "ppm:-"], timeout=20, stdin_bytes=data)
    if code != 0 or not ppm:
        return None
    return ocr_text(ppm, timeout)


def ocr_text(ppm, timeout):
    code, out, _ = run(["nice", "-n", "19", "tesseract", "-", "stdout",
                        "--psm", "6"], timeout=timeout, stdin_bytes=ppm)
    if code != 0:
        # None means "could not read", "" means "read it, no words on it".
        # Conflating them marked frames captured while tesseract was missing
        # as read-with-no-text, permanently and invisibly: pendingOcr showed
        # zero, and installing tesseract afterwards changed nothing.
        return None
    text = out.decode("utf-8", "replace")
    # tesseract emits a lot of whitespace scaffolding around real words.
    lines = [" ".join(line.split()) for line in text.splitlines()]
    return "\n".join(line for line in lines if line)


# --------------------------------------------------------------------------
# storage


def frame_path(ts):
    """(day, filename, full path). Nothing is created here: the caller opens
    the day directory through a descriptor so a symlink cannot redirect the
    write."""
    day = time.strftime("%Y-%m-%d", time.localtime(ts))
    stamp = time.strftime("%H%M%S", time.localtime(ts))
    name = "%s-%03d.webp" % (stamp, int(ts * 1000) % 1000)
    return day, name, os.path.join(FRAMES, day, name)


def store(conn, ts, path, app, title, monitor, hash_bits, size):
    day = time.strftime("%Y-%m-%d", time.localtime(ts))
    cur = conn.execute(
        "INSERT INTO frames(ts,day,path,app,title,monitor,hash,bytes,ocr)"
        " VALUES(?,?,?,?,?,?,?,?,0)",
        (ts, day, path, app, title, monitor, str(hash_bits), size))
    conn.commit()
    return cur.lastrowid


_ocr_probe = {"ok": None, "at": 0.0}
OCR_PROBE_INTERVAL = 300.0


def ocr_available(force=False):
    """Is tesseract usable? Cached, because this used to be asked once per
    failed frame, which on a machine without tesseract meant three process
    spawns every half second, for ever."""
    now = time.time()
    if (not force and _ocr_probe["ok"] is not None
            and now - _ocr_probe["at"] < OCR_PROBE_INTERVAL):
        return _ocr_probe["ok"]
    code, _, _ = run(["tesseract", "--version"], timeout=5)
    _ocr_probe["ok"] = (code == 0)
    _ocr_probe["at"] = now
    return _ocr_probe["ok"]


def note_ocr_failure(conn, frame_id):
    """Record why the text is missing, so the frame can be retried or not."""
    state = OCR_DONE_UNREADABLE if ocr_available() else OCR_TOOL_MISSING
    conn.execute("UPDATE frames SET ocr=? WHERE id=?", (state, frame_id))
    conn.commit()
    return state


def attach_text(conn, frame_id, text, app, title):
    conn.execute("DELETE FROM frames_fts WHERE rowid=?", (frame_id,))
    conn.execute(
        "INSERT INTO frames_fts(rowid,text,app,title) VALUES(?,?,?,?)",
        (frame_id, text, app or "", title or ""))
    conn.execute("UPDATE frames SET ocr=1 WHERE id=?", (frame_id,))
    conn.commit()


def unlink_frame(path):
    """Delete one frame, refusing anything that is not a regular file we own
    inside the archive.

    True means the row may go: the file is gone, or was never a frame of
    ours. False means try again later, so a missing mount does not quietly
    empty the index."""
    fds, name = archive_descend(path)
    if fds is None:
        if "unavailable" in name:
            log("cannot open the archive (%s); leaving %s alone" % (name, path))
            return False
        log("refusing to delete %s: %s" % (path, name))
        return True
    try:
        try:
            info = os.stat(name, dir_fd=fds[-1], follow_symlinks=False)
        except FileNotFoundError:
            return True
        except OSError as exc:
            log("could not inspect %s (%s)" % (path, exc))
            return False
        if not statmod.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
            log("refusing to delete %s: not a regular file of ours" % path)
            return True
        try:
            os.unlink(name, dir_fd=fds[-1])
        except FileNotFoundError:
            pass
        except OSError as exc:
            log("could not remove %s (%s)" % (path, exc))
            return False
        return True
    finally:
        close_fds(fds)


def drop_frames(conn, rows):
    """Delete frames from disk and both tables. rows is [(id, path), ...]."""
    removed = 0
    for frame_id, path in rows:
        if not unlink_frame(path):
            continue
        conn.execute("DELETE FROM frames WHERE id=?", (frame_id,))
        conn.execute("DELETE FROM frames_fts WHERE rowid=?", (frame_id,))
        removed += 1
    if removed:
        conn.commit()
    return removed


# Five minutes between sweeps. An orphan is a bug rather than a routine
# event, so finding one a few minutes late costs nothing.
ORPHAN_SWEEP_INTERVAL = 300.0
_orphan_sweep = {"at": 0.0}


def sweep_orphans(conn, grace=120.0):
    """Delete frames on disk that no row names.

    A frame whose row never landed is worse than wasted disk: search cannot
    reach it, and `forget` walks the index, so `forget all` leaves it behind.
    That happened for real - a tick that raised after writing the file and
    before storing the row left 71 of them - and it is cheap to make the
    archive self-correcting rather than trust that it cannot happen again.

    Only files older than the grace window are considered, because the
    recorder writes the file before it writes the row and a frame caught in
    that gap is not an orphan yet.
    """
    known = set()
    try:
        for (path,) in conn.execute("SELECT path FROM frames"):
            known.add(path)
    except sqlite3.Error:
        return 0
    root = os.path.join(DATA, "frames")
    cutoff = time.time() - grace
    removed = 0
    for base, _dirs, files in os.walk(root):
        for name in files:
            if not name.endswith(".webp"):
                continue
            path = os.path.join(base, name)
            if path in known:
                continue
            try:
                if os.lstat(path).st_mtime > cutoff:
                    continue
            except OSError:
                continue
            # Same guarded deletion the index-driven path uses: descends the
            # archive one component at a time and refuses anything that is
            # not a regular file of ours inside it.
            if unlink_frame(path):
                removed += 1
    if removed:
        log("removed %d frame(s) on disk that the index did not know about"
            % removed)
    return removed


def prune(conn, cfg):
    """Ring-buffer the archive: oldest frames go first, by age then by size."""
    removed = 0
    days = int(cfg.get("retentionDays") or 0)
    if days > 0:
        cutoff = time.time() - days * 86400
        rows = conn.execute(
            "SELECT id,path FROM frames WHERE ts<? ORDER BY ts", (cutoff,)
        ).fetchall()
        removed += drop_frames(conn, rows)

    budget = int(cfg["budgetMB"]) * 1024 * 1024
    # Checkpoint first: an unflushed WAL can be larger than the database and
    # would otherwise be charged to the user as if it were frames.
    try:
        conn.execute("PRAGMA wal_checkpoint(TRUNCATE)")
    except sqlite3.Error:
        pass
    # The index counts too, but it must never eat the whole budget: leave at
    # least half for frames so a fat index cannot prune the archive to nothing.
    room = max(budget // 2, budget - index_bytes())
    total = archive_total(usage(conn)[1])
    budget = room
    if total > budget:
        # Materialise the candidates first: deleting rows from under a live
        # cursor on the same table silently skips frames, so the archive would
        # creep over budget forever.
        # The column only decides *whether* to look; what gets deleted is
        # sized from disk. One edited row could otherwise still delete most
        # of the archive, because it controls the row count as well as the
        # value, and the loop walks oldest-first.
        rows = conn.execute("SELECT id,path,bytes FROM frames ORDER BY ts").fetchall()
        real = [(fid, path, disk_size(path, size)) for fid, path, size in rows]

        # Write the measured sizes back. Without this the cheap column check
        # above stays over budget for ever while the measured total is under
        # it: prune would walk the whole archive on every tick, delete
        # nothing, and never converge. Repairing the column ends that after
        # one pass, and leaves the panel showing a true figure.
        corrections = [(size, fid) for (fid, _, size), (_, _, was)
                       in zip(real, rows) if size != was]
        if corrections:
            log("index reported %d frame size(s) wrongly; corrected from disk"
                % len(corrections))
            conn.executemany("UPDATE frames SET bytes=? WHERE id=?", corrections)
            conn.commit()

        running = sum(size for _, _, size in real)
        doomed = []
        for frame_id, path, size in real:
            if running <= budget:
                break
            doomed.append((frame_id, path))
            running -= size
        removed += drop_frames(conn, doomed)
    # Throttled: the sweep walks the whole archive, and prune runs every
    # tick. At a hundred thousand frames that is a full walk every four
    # seconds to find something that should never appear at all.
    if time.time() - _orphan_sweep["at"] >= ORPHAN_SWEEP_INTERVAL:
        _orphan_sweep["at"] = time.time()
        removed += sweep_orphans(conn)
    if removed:
        empty_dirs()
        _archive_measure["at"] = 0.0
    return removed


def empty_dirs():
    """Drop day directories that pruning has emptied.

    The try used to wrap the whole loop, so one entry that could not be
    removed - a symlink, which os.path.isdir follows but os.rmdir refuses -
    stranded every day directory after it in listdir order."""
    try:
        names = os.listdir(FRAMES)
    except OSError:
        return
    for day in names:
        path = os.path.join(FRAMES, day)
        try:
            info = os.lstat(path)
            if not statmod.S_ISDIR(info.st_mode):
                continue          # a link is not a day directory of ours
            if not os.listdir(path):
                os.rmdir(path)
        except OSError:
            continue


ARCHIVE_MEASURE_INTERVAL = 300.0
_archive_measure = {"bytes": None, "at": 0.0}


def measure_archive(depth=0, fd=None):
    """Total bytes of real frames on disk, counted without trusting the index.

    The index is a file the user's account can edit, and the previous repair
    only ran once the column claimed the archive was over budget - so setting
    every size to zero turned the disk budget off completely and the repair
    could never see it. This asks the filesystem instead."""
    own = fd is None
    if own:
        fd = open_archive()
        if fd is None:
            return None
    total = 0
    try:
        for entry in os.scandir(fd):
            try:
                if entry.is_symlink():
                    continue
                if entry.is_dir(follow_symlinks=False):
                    if depth >= MAX_ARCHIVE_DEPTH:
                        continue
                    child = os.open(entry.name,
                                    os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                                    dir_fd=fd)
                    try:
                        nested = measure_archive(depth + 1, child)
                        total += nested or 0
                    finally:
                        os.close(child)
                elif entry.is_file(follow_symlinks=False):
                    total += min(entry.stat(follow_symlinks=False).st_size,
                                 MAX_FRAME_BYTES)
            except OSError:
                continue
    except OSError:
        return None
    finally:
        if own:
            try:
                os.close(fd)
            except OSError:
                pass
    return total


def archive_total(column_total):
    """The larger of what the index claims and what the disk actually holds.

    Re-measured on a timer as well as whenever the column looks over budget,
    so neither inflating nor deflating the column can steer pruning."""
    now = time.time()
    stale = now - _archive_measure["at"] > ARCHIVE_MEASURE_INTERVAL
    if stale or _archive_measure["bytes"] is None:
        measured = measure_archive()
        if measured is not None:
            _archive_measure["bytes"] = measured
            _archive_measure["at"] = now
    measured = _archive_measure["bytes"]
    return column_total if measured is None else max(column_total, measured)


def disk_size(path, recorded):
    """What a frame actually occupies, asked of the filesystem.

    Falls back to the clamped column only when the file cannot be measured,
    so a vanished frame does not stall pruning."""
    fds, name = archive_descend(path)
    if fds is None:
        return frame_bytes(recorded)
    try:
        return min(os.stat(name, dir_fd=fds[-1],
                           follow_symlinks=False).st_size, MAX_FRAME_BYTES)
    except OSError:
        return 0
    finally:
        close_fds(fds)


def frame_bytes(value):
    """A frame's size, clamped to something a frame could actually be.

    The column is written by this program but read back from a file anyone
    with the user's account can edit."""
    try:
        size = int(value or 0)
    except (TypeError, ValueError):
        return 0
    if size < 0:
        return 0
    return min(size, MAX_FRAME_BYTES)


def usage(conn):
    # Clamped in SQL rather than in Python: emit() calls this every tick, and
    # materialising every row was measured 7.8x slower on a large archive.
    row = conn.execute(
        "SELECT COUNT(*), COALESCE(SUM(MIN(MAX(COALESCE(bytes,0),0),?)),0)"
        " FROM frames", (MAX_FRAME_BYTES,)).fetchone()
    return int(row[0]), int(row[1])


def index_bytes():
    """The database is not free: the recognised text of every frame lives in
    it, and it was not being counted against the budget at all."""
    total = 0
    for suffix in ("", "-wal", "-shm"):
        try:
            total += os.path.getsize(DB_PATH + suffix)
        except OSError:
            pass
    return total


def disk_usage(conn):
    """Everything this plugin actually occupies, images and index alike."""
    frames, images = usage(conn)
    return frames, images + index_bytes()


# --------------------------------------------------------------------------
# capacity: how far back a given disk budget actually reaches
#
# Gigabytes are a unit nobody thinks in. "About three weeks" is. The honest
# translation between the two depends entirely on how much a particular
# screen changes, so the numbers below are a starting point that the user's
# own history replaces as soon as there is enough of it.

BOOTSTRAP_FRAME_BYTES = 88 * 1024   # measured: 1280x800 WebP at quality 60
BOOTSTRAP_KEEP_RATIO = 0.15         # measured: dedup kept ~2 of 16 idle ticks
ASSUMED_ACTIVE_HOURS = 8.0          # a working day, until we can count one
# However long a tick overran, the next one still waits: a loop with no
# floor under its sleep is a loop that spawns without limit under load.
MIN_SLEEP = 0.5
GAP_CEILING = 300.0                 # a gap longer than this is away, not usage
MIN_SAMPLE_FRAMES = 60
# Half an hour of real use before the estimate trusts itself. Two minutes of
# a scrolling terminal reads as 40 MB/hour and would tell a new user their
# disk holds days when it holds weeks; the bootstrap figure is less wrong.
MIN_SAMPLE_SECONDS = 1800.0
BUDGET_CHOICES_MB = [512, 1024, 2048, 4096, 8192, 16384, 32768]


def parse_size_mb(text):
    """'8G' / '8gb' / '512M' / '4096' -> megabytes. None if unparseable."""
    match = re.match(r"^\s*([0-9]*\.?[0-9]+)\s*([kmgt]?)b?\s*$",
                     str(text or ""), re.IGNORECASE)
    if not match:
        return None
    value = float(match.group(1))
    scale = {"": 1.0, "k": 1.0 / 1024, "m": 1.0, "g": 1024.0, "t": 1024.0 * 1024}
    megabytes = value * scale[match.group(2).lower()]
    if megabytes < 1:
        return None
    return int(round(megabytes))


def observed_rate(conn):
    """Bytes written per second of *active* use, or None without a sample.

    Gaps longer than GAP_CEILING are the machine being asleep, locked or
    paused. Counting them would stretch the estimate to flattery."""
    rows = conn.execute("SELECT ts,bytes FROM frames ORDER BY ts").fetchall()
    if len(rows) < MIN_SAMPLE_FRAMES:
        return None
    active = 0.0
    written = 0
    for index in range(1, len(rows)):
        gap = float(rows[index][0]) - float(rows[index - 1][0])
        if 0 < gap <= GAP_CEILING:
            active += gap
            written += int(rows[index][1] or 0)
    if active < MIN_SAMPLE_SECONDS or written <= 0:
        return None
    return written / active


def complete_day_totals(conn):
    """Bytes per day, excluding today and the oldest day - both are partial,
    and a half day dragged into the average makes the estimate optimistic."""
    rows = conn.execute(
        "SELECT day, SUM(bytes) FROM frames GROUP BY day ORDER BY day").fetchall()
    if len(rows) < 3:
        return []
    today = time.strftime("%Y-%m-%d")
    return sorted(int(total or 0) for day, total in rows[1:]
                  if day != today and total)


def capacity(conn, cfg, budget_mb=None):
    """What a budget buys, in time rather than bytes."""
    interval = max(1.0, float(cfg.get("interval") or DEFAULTS["interval"]))
    budget_mb = int(budget_mb if budget_mb else cfg["budgetMB"])
    budget = budget_mb * 1024 * 1024

    rate = observed_rate(conn)
    basis = "sampled"
    if rate is None:
        rate = BOOTSTRAP_FRAME_BYTES * BOOTSTRAP_KEEP_RATIO / interval
        basis = "default"

    # Every kept frame drags its recognised text into the index, so both rates
    # have to carry that overhead or the estimate runs optimistic. Applied
    # before the daily figure is derived, since that is what sizes the budget.
    frames, used = disk_usage(conn)
    _, images = usage(conn)
    overhead = max(1.0, float(used) / float(images)) if images > 0 else 1.0

    per_hour = rate * 3600.0 * overhead
    days_seen = complete_day_totals(conn)
    if len(days_seen) >= 2:
        middle = len(days_seen) // 2
        per_day = overhead * float(days_seen[middle] if len(days_seen) % 2
                                   else (days_seen[middle - 1]
                                         + days_seen[middle]) / 2.0)
        basis = "measured"
    else:
        per_day = per_hour * ASSUMED_ACTIVE_HOURS
    per_day = max(per_day, 1.0)

    return {
        "budgetMB": budget_mb,
        "budgetBytes": budget,
        "usedBytes": used,
        "frames": frames,
        "bytesPerActiveHour": int(per_hour),
        "bytesPerDay": int(per_day),
        "coverageHours": budget / per_hour if per_hour > 0 else 0.0,
        "coverageDays": budget / per_day,
        "basis": basis,
        "sampleDays": len(days_seen),
        "retentionDays": int(cfg.get("retentionDays") or 0),
    }


def coverage_text(estimate):
    """The one sentence a person actually wants: how far back does this go."""
    days = estimate["coverageDays"]
    capped = estimate.get("retentionDays") or 0
    if days < 1:
        headline = "about %d hours" % max(1, int(round(estimate["coverageHours"])))
    elif days < 14:
        headline = "about %d days" % int(round(days))
    elif days < 70:
        headline = "about %d weeks" % int(round(days / 7.0))
    else:
        headline = "about %d months" % max(1, int(round(days / 30.0)))
    if capped and days > capped:
        return "%d days (your age limit; disk alone would reach %s)" % (
            capped, headline)
    return headline


def save_config(patch):
    """Merge into the user's config without discarding keys we did not set."""
    ensure_dirs()
    current = {}
    try:
        raw = read_private(CONFIG)
        if raw is None:
            current = dict(DEFAULTS)
        else:
            loaded = json.loads(raw)
            current = loaded if isinstance(loaded, dict) else dict(DEFAULTS)
    except Unreadable as exc:
        # Refusing to read it is not licence to replace it. Overwriting here
        # would have deleted a symlinked dotfiles config and everything in it.
        log("not touching your config: %s" % exc)
        return None
    except Exception as exc:
        log("config unreadable (%s), rewriting from defaults" % exc)
        current = dict(DEFAULTS)
    current.update(patch)
    tmp = CONFIG + ".tmp"
    try:
        os.unlink(tmp)
    except OSError:
        pass
    if write_private(tmp, json.dumps(current, indent=2, sort_keys=True)):
        os.replace(tmp, CONFIG)
        secure(CONFIG, FILE_MODE)
    return current


# --------------------------------------------------------------------------
# the watch loop


class Recorder:
    def __init__(self):
        self.cfg = load_config()
        self.conn = connect()
        harden_all()
        self.stop = threading.Event()
        self.jobs = queue.Queue(maxsize=OCR_QUEUE_MAX)
        self.last_hash = None
        self.dropped_ocr = 0
        self.emitted = None
        self.worker = None
        self.coverage_cache = {}
        self.coverage_at = 0.0
        self.cfg_stamp = config_stamp()

    # -- OCR runs off the capture thread; a slow read must never delay a frame.
    def ocr_worker(self):
        conn = connect()
        while not self.stop.is_set():
            try:
                job = self.jobs.get(timeout=0.5)
            except queue.Empty:
                # Nothing live to read, so catch up on anything that was
                # dropped while the queue was full, or left behind by an index
                # rebuild. The image is still on disk, so the text is not lost.
                self.backfill(conn)
                continue
            if job is None:
                break
            frame_id, ppm, app, title = job
            try:
                text = ocr_text(ppm, self.cfg["ocrTimeout"])
                if text is None:
                    note_ocr_failure(conn, frame_id)
                else:
                    attach_text(conn, frame_id, text, app, title)
            except Exception as exc:
                log("ocr failed for frame %s (%s)" % (frame_id, exc))
            finally:
                self.jobs.task_done()
        conn.close()

    def backfill(self, conn):
        if not self.cfg.get("ocr"):
            return
        # Frames captured while tesseract was missing are only worth
        # re-reading once it is back. Asking that question is itself a
        # process spawn, so it is cached and only refreshed occasionally.
        retry_missing = ocr_available()
        row = conn.execute(
            "SELECT id,path,app,title FROM frames WHERE ocr IN (?,?)"
            " ORDER BY ts DESC LIMIT 1",
            (OCR_PENDING, OCR_TOOL_MISSING if retry_missing else OCR_PENDING)
        ).fetchone()
        if not row:
            return
        frame_id, path, app, title = row
        if not os.path.exists(path):
            # The frame was pruned out from under us; stop it being retried
            # forever by taking the row with it.
            drop_frames(conn, [(frame_id, path)])
            return
        try:
            text = ocr_frame_file(path, self.cfg["ocrTimeout"])
            if text is None:
                note_ocr_failure(conn, frame_id)
                return
            attach_text(conn, frame_id, text, app, title)
        except Exception as exc:
            log("backfill failed for frame %s (%s)" % (frame_id, exc))

    def queue_ocr(self, frame_id, ppm, app, title):
        if not self.cfg.get("ocr"):
            return
        try:
            self.jobs.put_nowait((frame_id, ppm, app, title))
        except queue.Full:
            # Better to lose the text of one frame than to fall behind the
            # screen. The frame itself is already safely on disk.
            self.dropped_ocr += 1

    def paused(self):
        return os.path.exists(PAUSE_MARKER)

    def coverage(self):
        """Days-of-history for the bar. Cached: the estimate walks every row,
        which is cheap once every few minutes and silly once every 4 seconds."""
        now = time.time()
        if not self.coverage_cache or now - self.coverage_at > 300:
            try:
                estimate = capacity(self.conn, self.cfg)
                self.coverage_cache = {
                    # Whole days only: a float here would change on every tick
                    # and defeat the change-only emission below.
                    "coverageDays": int(round(estimate["coverageDays"])),
                    "coverageText": coverage_text(estimate),
                    "coverageBasis": estimate["basis"],
                }
            except sqlite3.Error as exc:
                log("coverage estimate failed: %s" % exc)
                self.coverage_cache = {}
            self.coverage_at = now
        return self.coverage_cache

    def refuse(self, reason, rule=""):
        """Say why no frame was taken, naming the rule when one matched."""
        if rule:
            self.emit(reason=reason, capturing=False, blockedBy=rule)
        else:
            self.emit(reason=reason, capturing=False)

    def emit(self, **extra):
        frames, total = usage(self.conn)
        today = time.strftime("%Y-%m-%d")
        today_count = self.conn.execute(
            "SELECT COUNT(*) FROM frames WHERE day=?", (today,)).fetchone()[0]
        pending = self.conn.execute(
            "SELECT COUNT(*) FROM frames WHERE ocr=0").fetchone()[0]
        state = {
            "paused": self.paused(),
            "frames": frames,
            "today": int(today_count),
            "bytes": total,
            "budget": int(self.cfg["budgetMB"]) * 1024 * 1024,
            "pendingOcr": int(pending),
            "droppedOcr": self.dropped_ocr,
            "ocr": bool(self.cfg.get("ocr")),
            "interval": self.cfg["interval"],
        }
        state.update(self.coverage())
        state.update(extra)
        # Only speak when something actually changed, so an idle desktop is a
        # silent one. Proven pattern; keeps the shell from re-rendering forever.
        compact = json.dumps(state, sort_keys=True)
        if compact == self.emitted:
            return
        # Marked as sent only once both the file and the pipe have taken it.
        # Setting it earlier meant one failed write wedged the bar on a stale
        # state forever, because every later tick compared equal and returned.
        if not write_private(STATE_PATH, json.dumps(state)):
            return
        try:
            sys.stdout.write(compact + "\n")
            sys.stdout.flush()
        except (OSError, ValueError):
            return
        self.emitted = compact

    def tick(self):
        # A blocklist the user just added has to take effect now, not at next
        # login. The recorder read its config once at startup, so an app added
        # to protect something kept being captured until the shell restarted.
        stamp = config_stamp()
        if stamp != getattr(self, "cfg_stamp", None):
            self.cfg_stamp = stamp
            self.cfg = load_config()
            log("config reloaded")
            self.coverage_at = 0.0

        if self.paused():
            self.emit(reason="paused", capturing=False)
            return

        # Every gate below fails closed. If a probe cannot answer, the frame
        # is not taken: the cost of a missed frame is a gap in the archive,
        # and the cost of a wrong answer is a recorded password.
        #
        # The lock check runs last of the probes rather than first. It is the
        # slowest (four pgrep spawns and a loginctl call, ~105 ms measured)
        # and the most consequential, so asking it first meant its answer was
        # the stalest thing in the frame.
        probed, monitor, awake = focused_monitor()
        if not probed:
            self.emit(reason="display state unknown", capturing=False)
            return
        if not awake:
            self.emit(reason="screen off", capturing=False)
            return

        # The frame is never taken when this refuses, so there is nothing to
        # delete afterwards, because nothing existed.
        reason, rule, app, title = capture_gate(self.cfg, monitor)
        if reason:
            self.refuse(reason, rule)
            return

        ppm, err = capture(monitor)
        if ppm is None:
            self.emit(reason=err or "capture failed", capturing=False)
            return

        bits = average_hash(ppm)
        if bits is None:
            self.emit(reason="unreadable frame", capturing=False)
            return

        if distance(bits, self.last_hash) < self.cfg["changeBits"]:
            self.emit(reason="", capturing=True, app=app)
            return

        # Second look, now that this frame is going to be kept. Every gate
        # above was answered before grim ran, and a screen can lock or a
        # notification can finish fading in inside that gap. The frame is
        # still only in memory here, so it costs nothing to drop it. Paid
        # once per kept frame rather than once per tick, because change
        # detection has already discarded the rest.
        reason, rule, _, _ = capture_gate(self.cfg, monitor)
        if reason:
            self.refuse(reason, rule)
            return

        webp, err = encode_webp(ppm, self.cfg["quality"])
        if webp is None:
            self.emit(reason=err or "encode failed", capturing=False)
            return

        now = time.time()
        day, name, path = frame_path(now)
        try:
            day_fd = open_day_dir(day)
            if day_fd is None:
                self.emit(reason="archive unavailable", capturing=False)
                return
            try:
                ok = write_private(None, webp, dir_fd=day_fd, name=name)
            finally:
                try:
                    os.close(day_fd)
                except OSError:
                    pass
            if not ok:
                self.emit(reason="could not write frame", capturing=False)
                return
        except OSError as exc:
            self.emit(reason="disk error: %s" % exc, capturing=False)
            return

        self.last_hash = bits
        frame_id = store(self.conn, now, path, app, title, monitor or "",
                         bits, len(webp))
        self.queue_ocr(frame_id, ppm, app, title)
        prune(self.conn, self.cfg)
        self.emit(reason="", capturing=True, app=app, lastFrame=now)

    def run(self):
        self.worker = threading.Thread(target=self.ocr_worker, daemon=True)
        self.worker.start()

        def bye(*_):
            self.stop.set()
        signal.signal(signal.SIGTERM, bye)
        signal.signal(signal.SIGINT, bye)

        self.emit(reason="starting", capturing=not self.paused())
        while not self.stop.is_set():
            started = time.time()
            try:
                self.tick()
            except sqlite3.Error as exc:
                log("database error: %s" % exc)
            except Exception as exc:
                log("tick failed: %s" % exc)
            # A tick that overran its interval used to sleep for nothing at
            # all, so a compositor answering slowly turned the loop into a
            # subprocess storm exactly when the machine could least take one.
            delay = self.cfg["interval"] - (time.time() - started)
            self.stop.wait(max(delay, MIN_SLEEP))
        try:
            self.jobs.put_nowait(None)
        except queue.Full:
            pass
        return 0


# --------------------------------------------------------------------------
# commands


def inside_archive(path):
    """True when a stored path really names a frame we could open.

    Search results feed the panel, which renders the path as an image, so
    this has to agree with the walk the rest of the program uses. As a pure
    string test it was strictly weaker: it accepted names that
    archive_descend refuses, and it could not see a symlink at all, so a
    planted link still reached the viewer.
    """
    fds, name = archive_descend(path or "")
    if fds is None:
        return False
    try:
        info = os.stat(name, dir_fd=fds[-1], follow_symlinks=False)
        return statmod.S_ISREG(info.st_mode) and info.st_uid == os.getuid()
    except OSError:
        return False
    finally:
        close_fds(fds)


def fts_query(term):
    """Turn what a person typed into something FTS5 will not reject.

    Users type apostrophes, hyphens and stray quotes; FTS5 treats several of
    those as syntax and raises. Quoting each bare word keeps the search box
    from throwing errors at people who typed a normal sentence.
    """
    words = re.findall(r"[\w./:@-]+", term or "", re.UNICODE)
    # A token of pure punctuation ("---", "...") survives the split but
    # tokenises to nothing. Measured: FTS5 quietly ignores such a phrase rather
    # than raising, so this is about not sending noise - and about "   ---   "
    # alone becoming an empty match instead of a query that scans everything.
    kept = [word.replace('"', "") for word in words
            if any(char.isalnum() for char in word)]
    if not kept:
        return ""
    # Nobody types "python3" when looking for python, or "ModuleNotFoundError"
    # when they remember "module". Anything long enough to be specific matches
    # as a prefix; short words stay exact so "in" does not match half the day.
    return " ".join(
        ('"%s"*' % word) if len(word) >= 4 else ('"%s"' % word)
        for word in kept)


def cmd_search(args):
    term = " ".join(args).strip()
    conn = connect()
    if not term:
        print(json.dumps({"query": "", "results": []}))
        return 0
    match = fts_query(term)
    if not match:
        print(json.dumps({"query": term, "results": []}))
        return 0
    try:
        rows = conn.execute("""
            SELECT f.id, f.ts, f.app, f.title, f.path,
                   snippet(frames_fts, 0, '‹', '›', '...', 12),
                   LENGTH(frames_fts.text), f.hash
            FROM frames_fts
            JOIN frames f ON f.id = frames_fts.rowid
            WHERE frames_fts MATCH ?
            ORDER BY rank
            LIMIT 240""", (match,)).fetchall()
    except sqlite3.Error as exc:
        print(json.dumps({"query": term, "results": [], "error": str(exc)}))
        return 1
    # Keep BM25's ordering, but a frame with almost no words on it is noise
    # however well it scores: there is no context to recognise the moment by.
    rows = [row for row in rows if (row[6] or 0) >= MIN_RESULT_CHARS] or rows

    # Collapse frames that show the same moment, keeping the best-ranked one.
    kept = []
    seen_hashes = []
    seen_text = []
    for row in rows:
        # Two frames can look different - a sidebar moved, the clock ticked -
        # and still say the same thing where it matters, so the excerpt is
        # checked as well as the picture.
        excerpt = re.sub(r"[^a-z0-9]+", " ", (row[5] or "").lower()).strip()
        # OCR rarely misreads the same screen the same way twice, so exact
        # matching is not enough; near-identical excerpts are one moment too.
        if excerpt and (excerpt in seen_text or any(
                difflib.SequenceMatcher(None, excerpt, other).ratio() > 0.75
                for other in seen_text[-12:])):
            continue
        try:
            bits = int(row[7])
        except (TypeError, ValueError):
            bits = None
        if bits is not None and any(
                distance(bits, other) < RESULT_SAME_MOMENT_BITS for other in seen_hashes):
            continue
        if bits is not None:
            seen_hashes.append(bits)
        if excerpt:
            seen_text.append(excerpt)
        kept.append(row)
    rows = kept

    rows = [row for row in rows if inside_archive(row[4])]
    results = [{
        "id": row[0],
        "ts": row[1],
        "time": time.strftime("%a %H:%M", time.localtime(row[1])),
        "day": time.strftime("%Y-%m-%d", time.localtime(row[1])),
        "app": row[2] or "",
        "title": row[3] or "",
        "path": row[4],
        "snippet": row[5] or "",
    } for row in rows[:60]]
    print(json.dumps({"query": term, "results": results}))
    return 0


def cmd_timeline(args):
    day = args[0] if args else time.strftime("%Y-%m-%d")
    conn = connect()
    rows = conn.execute(
        "SELECT id,ts,app,title,path FROM frames WHERE day=? ORDER BY ts",
        (day,)).fetchall()
    rows = [r for r in rows if inside_archive(r[4])]
    print(json.dumps({"day": day, "frames": [{
        "id": r[0],
        "ts": r[1],
        "time": time.strftime("%H:%M", time.localtime(r[1])),
        "app": r[2] or "",
        "title": r[3] or "",
        "path": r[4],
    } for r in rows]}))
    return 0


def cmd_text(args):
    if not args:
        log("usage: hindsight text <frame-id>")
        return 2
    conn = connect()
    row = conn.execute(
        "SELECT text FROM frames_fts WHERE rowid=?", (int(args[0]),)).fetchone()
    sys.stdout.write((row[0] if row else "") or "")
    return 0


def cmd_status(_args):
    try:
        raw = read_private(STATE_PATH)
        state = json.loads(raw) if raw else {}
        if not isinstance(state, dict):
            state = {}
    except Exception:
        state = {}
    conn = connect()
    frames, total = usage(conn)
    state.setdefault("frames", frames)
    state.setdefault("bytes", total)
    state["paused"] = os.path.exists(PAUSE_MARKER)
    print(json.dumps(state, sort_keys=True))
    return 0


def set_paused(paused):
    """Report the state the marker is actually in, not the one asked for.

    Printing the requested state regardless meant a failed write (a dangling
    symlink at the marker, a full disk) produced {"paused": true} while
    capture carried on, and the bar showed the paused glyph over a recording
    session."""
    ensure_dirs()
    if paused:
        write_private(PAUSE_MARKER, str(time.time()))
    else:
        try:
            os.remove(PAUSE_MARKER)
        except FileNotFoundError:
            pass
        except OSError as exc:
            log("could not clear the pause marker (%s)" % exc)
    actual = os.path.exists(PAUSE_MARKER)
    print(json.dumps({"paused": actual}))
    if actual != paused:
        log("could not %s: the pause marker is still %s"
            % ("pause" if paused else "resume",
               "set" if actual else "absent"))
        return 1
    return 0


def cmd_pause(_a):
    return set_paused(True)


def cmd_resume(_a):
    return set_paused(False)


def cmd_toggle(_a):
    return set_paused(not os.path.exists(PAUSE_MARKER))


def cmd_prune(_args):
    conn = connect()
    cfg = load_config()
    removed = prune(conn, cfg)
    frames, total = usage(conn)
    print(json.dumps({"removed": removed, "frames": frames, "bytes": total}))
    return 0


def cmd_forget(args):
    """Delete history. 'today', a YYYY-MM-DD day, or 'all'."""
    if not args:
        log("usage: hindsight forget <all|today|YYYY-MM-DD>")
        return 2
    target = args[0]
    conn = connect()
    if target == "all":
        rows = conn.execute("SELECT id,path FROM frames").fetchall()
    else:
        day = time.strftime("%Y-%m-%d") if target == "today" else target
        rows = conn.execute(
            "SELECT id,path FROM frames WHERE day=?", (day,)).fetchall()
    removed = drop_frames(conn, rows)
    empty_dirs()
    print(json.dumps({"forgot": removed, "target": target}))
    return 0


def cmd_doctor(_args):
    cfg = load_config()
    report = {"ok": True, "checks": []}

    def check(name, ok, detail=""):
        report["checks"].append({"name": name, "ok": bool(ok), "detail": detail})
        if not ok:
            report["ok"] = False

    for tool, why in (("grim", "screen capture"),
                      ("magick", "webp encoding"),
                      ("tesseract", "text recognition"),
                      ("hyprctl", "active window and monitors")):
        path = shutil.which(tool)
        check(tool, path is not None, path or "not found (%s)" % why)

    check("sqlite FTS5", fts_supported(), sqlite3.sqlite_version)

    probed, monitor, awake = focused_monitor()
    check("focused output", monitor is not None,
          "%s%s" % (monitor or "unknown", "" if awake else " (screen off)"))

    # doctor used to screenshot unconditionally, so running it while the
    # session was locked, paused, or showing a blocked window took exactly the
    # frame the plugin promises never to take.
    refuse = ""
    if os.path.exists(PAUSE_MARKER):
        refuse = "paused"
    elif not probed or not monitor or not awake:
        refuse = "the display is off, or cannot be asked"
    else:
        # The same gate the recorder uses, refusing for the same reasons.
        reason, rule, _, _ = capture_gate(cfg, monitor)
        if rule:
            refuse = "a blocked window is on screen (%s)" % rule
        elif reason:
            refuse = reason
    if refuse:
        check("capture", True, "not attempted: %s" % refuse)
    else:
        ppm, err = capture(monitor)
        check("capture", ppm is not None,
              "%d bytes" % len(ppm) if ppm else err)
        if ppm:
            bits = average_hash(ppm)
            check("frame hash", bits is not None,
                  "%d/%d bits set" % (bin(bits).count("1"), HASH_BITS)
                  if bits else "unparsed")

    exposed = []
    for root in (DATA, os.path.dirname(CONFIG)):
        for base, dirs, files in os.walk(root):
            for name in list(dirs) + list(files):
                target = os.path.join(base, name)
                try:
                    if os.stat(target).st_mode & 0o077:
                        exposed.append(target)
                except OSError:
                    pass
            if len(exposed) > 5:
                break
    locked_state = session_locked()
    check("lock state", locked_state is not None,
          "unlocked" if locked_state is False else
          ("locked" if locked_state else
           "no logind session answered, so capture stays off"))

    check("permissions", not exposed,
          "%d path(s) readable by other users, e.g. %s"
          % (len(exposed), exposed[0]) if exposed else "private to you")

    try:
        stat = os.statvfs(DATA if os.path.isdir(DATA) else HOME)
        free = stat.f_bavail * stat.f_frsize
        check("disk", free > 512 * 1024 * 1024, "%.1f GB free" % (free / 1e9))
    except OSError as exc:
        check("disk", False, str(exc))

    conn = connect()
    try:
        stalled = conn.execute("SELECT COUNT(*) FROM frames WHERE ocr=?",
                               (OCR_TOOL_MISSING,)).fetchone()[0]
    except sqlite3.Error:
        stalled = 0
    check("text indexing", not stalled,
          ("%d frame(s) captured while tesseract was unavailable; they are "
           "retried automatically" % stalled) if stalled else "up to date")

    frames, total = usage(conn)
    report["frames"] = frames
    report["bytes"] = total
    report["budgetBytes"] = int(cfg["budgetMB"]) * 1024 * 1024
    report["paused"] = os.path.exists(PAUSE_MARKER)
    report["data"] = DATA
    report["config"] = CONFIG
    report["network"] = "never"
    print(json.dumps(report, indent=2, sort_keys=True))
    return 0 if report["ok"] else 1


def human_bytes(count):
    count = float(count or 0)
    for unit in ("B", "KB", "MB", "GB"):
        if count < 1024 or unit == "GB":
            return "%.0f %s" % (count, unit) if unit == "B" else "%.1f %s" % (count, unit)
        count /= 1024.0


def human_mb(megabytes):
    if megabytes >= 1024 and megabytes % 1024 == 0:
        return "%d GB" % (megabytes // 1024)
    if megabytes >= 1024:
        return "%.1f GB" % (megabytes / 1024.0)
    return "%d MB" % megabytes


def cmd_budget(args):
    """Show, or set, how much disk the archive may use - in days, not bytes."""
    cfg = load_config()
    as_json = "--json" in args
    wanted = [a for a in args if not a.startswith("-")]

    if wanted:
        megabytes = parse_size_mb(wanted[0])
        if megabytes is None:
            log("unreadable size: %s (try 8G, 512M or 4096)" % wanted[0])
            return 2
        cfg = load_config()
        cfg["budgetMB"] = max(64, megabytes)
        save_config({"budgetMB": cfg["budgetMB"]})
        conn = connect()
        freed = prune(conn, cfg)
        if freed:
            log("budget lowered; dropped %d frame(s) to fit" % freed)
    else:
        conn = connect()

    estimate = capacity(conn, cfg)
    if as_json:
        # A budget set by hand from the CLI still gets a chip of its own,
        # otherwise the panel would show nothing as selected.
        choices = sorted(set(BUDGET_CHOICES_MB) | {estimate["budgetMB"]})
        estimate["options"] = [
            {"mb": mb, "label": human_mb(mb),
             "text": coverage_text(capacity(conn, cfg, mb))}
            for mb in choices
        ]
        estimate["text"] = coverage_text(estimate)
        print(json.dumps(estimate, sort_keys=True))
        return 0

    note = {
        "measured": "from %d full days of your own history" % estimate["sampleDays"],
        "sampled": "from your history so far, assuming an %d-hour day"
                   % int(ASSUMED_ACTIVE_HOURS),
        "default": "estimate only - not enough history yet",
    }[estimate["basis"]]
    print("budget    %s (%s used, %d frames)" % (
        human_mb(estimate["budgetMB"]), human_bytes(estimate["usedBytes"]),
        estimate["frames"]))
    print("reaches   %s  (%s)" % (coverage_text(estimate), note))
    print("rate      %s per active hour" % human_bytes(estimate["bytesPerActiveHour"]))
    print("")
    for mb in BUDGET_CHOICES_MB:
        mark = "->" if mb == estimate["budgetMB"] else "  "
        print("%s %-8s %s" % (mark, human_mb(mb),
                              coverage_text(capacity(conn, cfg, mb))))
    print("")
    print("set with: hindsight budget 8G")
    return 0


def cmd_config(_args):
    ensure_dirs()
    if not os.path.exists(CONFIG):
        write_private(CONFIG, json.dumps(DEFAULTS, indent=2, sort_keys=True))
    print(CONFIG)
    return 0


def cmd_watch(_args):
    if not fts_supported():
        log("this python's sqlite has no FTS5; search will not work")
    return Recorder().run()


COMMANDS = {
    "watch": cmd_watch,
    "search": cmd_search,
    "timeline": cmd_timeline,
    "text": cmd_text,
    "status": cmd_status,
    "pause": cmd_pause,
    "resume": cmd_resume,
    "toggle": cmd_toggle,
    "prune": cmd_prune,
    "forget": cmd_forget,
    "doctor": cmd_doctor,
    "budget": cmd_budget,
    "config": cmd_config,
}


def main(argv):
    # Belt and braces: umask makes every new file and directory private no
    # matter which code path creates it, including SQLite's own db/wal/shm.
    os.umask(0o077)

    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        sys.stdout.write(
            "hindsight - a local, searchable memory of your screen\n\n"
            "  watch                 run the recorder (used by the bar)\n"
            "  search <words>        full-text search across captured screens\n"
            "  timeline [day]        frames for a day, oldest first\n"
            "  text <id>             the recognised text of one frame\n"
            "  status                current recorder state\n"
            "  pause | resume | toggle\n"
            "  prune                 enforce the size and age budget now\n"
            "  budget [size]         show, or set, disk budget as days of history\n"
            "  forget <all|today|YYYY-MM-DD>\n"
            "  doctor                check dependencies and capture\n"
            "  config                print (creating if needed) the config path\n")
        return 0
    handler = COMMANDS.get(argv[1])
    if not handler:
        log("unknown command: %s" % argv[1])
        return 2
    try:
        return handler(argv[2:])
    except BrokenPipeError:
        return 0
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
